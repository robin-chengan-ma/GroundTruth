# Phase 7：根目錄 docker-compose.yml 一鍵啟動用。複製為 .env 後填入真實值，
# .env 本身不進版控（見 .gitignore）。個別服務目錄下的 backend/.env.example、
# n8n/.env.example 為本機不使用 Docker、單獨啟動各服務時使用，欄位與此檔重疊。

# --- PostgreSQL ---
POSTGRES_DB=groundtruth
POSTGRES_USER=groundtruth
POSTGRES_PASSWORD=

# --- Django ---
DJANGO_SECRET_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
REFRESH_COOKIE_SECURE=false
# 容器啟動時是否自動灌入 demo 種子資料（冪等，不清空／不覆蓋既有資料）；
# 不需要 demo 假資料時（例如改接正式資料）可設為 false。
LOAD_DEMO_DATA=true

# --- n8n ↔ Django 內部服務認證，兩邊必須填一致的值 ---
INTERNAL_API_KEY=

# --- n8n ---
GEMINI_API_KEY=

# --- Gmail 通知信連結（FR-8）---
# 使用者瀏覽器會開的前端網址；預設對應本檔 frontend 服務的 host 對外埠，
# 只有不是在 localhost 展示（例如部署到區網其他主機）時才需要覆寫。
# FRONTEND_BASE_URL=http://localhost:5173
