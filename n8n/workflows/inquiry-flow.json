        "jsCode": "// 整合：LLM 解析結果 + 供應商查詢 + 產品查詢 + 詢價發起人 user_id。\nconst parsed = $('解析 LLM 輸出').first().json;\nconst supplierResult = $('查詢供應商').first().json.results?.[0];\nconst productResult = $input.first().json.results?.[0];\nconst userId = $('Webhook 接收詢價').first().json.body.user_id;\n\nif (!supplierResult) {\n  throw new Error(`查無供應商：${$('Unmask 供應商').first().json.text}`);\n}\nif (!productResult) {\n  throw new Error(`查無產品：${parsed.item}`);\n}\n\nreturn [{\n  json: {\n    user_id: userId,\n    product_id: productResult.id,\n    product_name: productResult.name,\n    supplier_id: supplierResult.id,\n    supplier_name: supplierResult.name,\n    quantity: parsed.quantity,\n  }\n}];"
