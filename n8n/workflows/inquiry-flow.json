      "id": "http-gemini-parse",
      "name": "Gemini 解析詢價",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        40,
        -160
      ]
    },
    {
      "parameters": {
        "jsCode": "// 從 Gemini 回應中取出文字，解析成結構化物件。\n// FR-2b：數量必須是原文明確提供的正整數，不接受 LLM 自行猜測。\nconst text = $input.first().json.candidates[0].content.parts[0].text;\nlet parsed;\ntry {\n  const cleaned = text.replace(/```json|```/g, '').trim();\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  return [{ json: { parse_error: true } }];\n}\n\nconst parseChineseInteger = value => {\n  const digits = { 零: 0, 〇: 0, 一: 1, 二: 2, 兩: 2, 三: 3, 四: 4, 五: 5, 六: 6, 七: 7, 八: 8, 九: 9 };\n  const units = { 十: 10, 百: 100, 千: 1000, 萬: 10000 };\n  let total = 0, section = 0, number = 0;\n  for (const character of value) {\n    if (character in digits) { number = digits[character]; continue; }\n    const unit = units[character];\n    if (unit === 10000) { total += (section + number) * unit; section = 0; number = 0; }\n    else { section += (number || 1) * unit; number = 0; }\n  }\n  return total + section + number;\n};\n\nconst quantity = Number(parsed.quantity);\nconst rawText = String($('Webhook 接收詢價').first().json.body.raw_text || '').replace(/[０-９]/g, digit => String('０１２３４５６７８９'.indexOf(digit)));\nconst explicitQuantities = [\n  ...[...rawText.matchAll(/([1-9]\\d*)\\s*(?:個|件|台|組|箱|張|支|份|套|包|瓶|顆|本|盒)/g)].map(match => Number(match[1])),\n  ...[...rawText.matchAll(/數量\\s*[:：]?\\s*([1-9]\\d*)/g)].map(match => Number(match[1])),\n  ...[...rawText.matchAll(/([零〇一二兩三四五六七八九十百千萬]+)\\s*(?:個|件|台|組|箱|張|支|份|套|包|瓶|顆|本|盒)/g)].map(match => parseChineseInteger(match[1])),\n  ...[...rawText.matchAll(/數量\\s*[:：]?\\s*([零〇一二兩三四五六七八九十百千萬]+)/g)].map(match => parseChineseInteger(match[1])),\n];\nif (!parsed.item || !parsed.supplier || !Number.isInteger(quantity) || !explicitQuantities.includes(quantity)) {\n  return [{ json: { parse_error: true } }];\n}\n\nreturn [{\n  json: {\n    parse_error: false,\n    item: parsed.item,\n    quantity,\n    supplier_token: parsed.supplier,\n    currency: parsed.currency || 'TWD',\n  }\n}];\n"
      },
