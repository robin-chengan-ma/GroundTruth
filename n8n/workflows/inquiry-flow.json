        "jsCode": "// webhook body 已經帶 user_id、supplier_id（人工複核核准時確認的）；\n// 只有 product 需要查、quantity 需要 LLM 解析。\nconst webhookBody = $('Webhook 續傳詢價').first().json.body;\nconst parsed = $('解析 LLM 輸出（續傳）').first().json;\nconst productResult = $('查詢產品（續傳）').first().json.results?.[0];\n\nif (!productResult) {\n  throw new Error(`查無產品：${parsed.item}`);\n}\n\nreturn [{\n  json: {\n    user_id: webhookBody.user_id,\n    product_id: productResult.id,\n    product_name: productResult.name,\n    supplier_id: webhookBody.supplier_id,\n    quantity: parsed.quantity,\n  }\n}];"
